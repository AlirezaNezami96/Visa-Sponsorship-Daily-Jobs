{
  "title": "Visa Sponsorship Jobs Scraper",
  "description": "Find jobs where visa sponsorship is actually available. Cross-references official government sponsor registries (UK, US) with live ATS job boards.",
  "type": "object",
  "schemaVersion": 1,
  "properties": {
    "visaSponsorshipOnly": {
      "title": "Visa Sponsorship Only",
      "type": "boolean",
      "description": "Only return jobs with confirmed sponsorship signals (official sponsor lists, historical filings, or explicit JD statements).",
      "default": true,
      "sectionCaption": "Quick Start",
      "sectionDescription": "Configure your job search in 30 seconds. Leave defaults for a visa-focused search."
    },
    "keywords": {
      "title": "Keywords",
      "type": "array",
      "description": "Job titles or skills to search for (e.g., Machine Learning, Android, Python).",
      "editor": "stringList",
      "default": [],
      "prefill": [
        "Software Engineer",
        "Machine Learning"
      ]
    },
    "countries": {
      "title": "Countries",
      "type": "array",
      "description": "Filter by target countries (Europe, East Asia, Americas, Arab countries, and more).",
      "editor": "select",
      "items": {
        "type": "string",
        "enum": [
          "Argentina",
          "Australia",
          "Austria",
          "Bahrain",
          "Bangladesh",
          "Belgium",
          "Brazil",
          "Bulgaria",
          "Canada",
          "Chile",
          "China",
          "Colombia",
          "Croatia",
          "Cyprus",
          "Czech Republic",
          "Denmark",
          "Egypt",
          "Estonia",
          "Finland",
          "France",
          "Germany",
          "Greece",
          "Hong Kong",
          "Hungary",
          "Iceland",
          "India",
          "Indonesia",
          "Ireland",
          "Israel",
          "Italy",
          "Japan",
          "Jordan",
          "Kuwait",
          "Latvia",
          "Lebanon",
          "Lithuania",
          "Luxembourg",
          "Malaysia",
          "Malta",
          "Mexico",
          "Morocco",
          "Netherlands",
          "New Zealand",
          "Norway",
          "Oman",
          "Pakistan",
          "Peru",
          "Philippines",
          "Poland",
          "Portugal",
          "Qatar",
          "Romania",
          "Saudi Arabia",
          "Serbia",
          "Singapore",
          "Slovakia",
          "Slovenia",
          "South Korea",
          "Spain",
          "Sweden",
          "Switzerland",
          "Taiwan",
          "Thailand",
          "Ukraine",
          "United Arab Emirates",
          "United Kingdom",
          "United States",
          "Uruguay",
          "Vietnam"
        ]
      },
      "default": [],
      "prefill": [
        "United Kingdom",
        "Germany",
        "United States",
        "United Arab Emirates"
      ]
    },
    "remoteOnly": {
      "title": "Remote Only",
      "type": "boolean",
      "description": "Only return fully remote positions.",
      "default": false
    },
    "seniorityLevels": {
      "title": "Seniority",
      "type": "array",
      "description": "Filter by seniority level (leave empty for all).",
      "editor": "select",
      "items": {
        "type": "string",
        "enum": [
          "intern",
          "junior",
          "mid",
          "senior",
          "lead"
        ],
        "enumTitles": [
          "Internship",
          "Junior",
          "Mid-Level",
          "Senior",
          "Lead"
        ]
      },
      "default": []
    },
    "maxResults": {
      "title": "Max Results",
      "type": "integer",
      "description": "Maximum number of jobs to return.",
      "default": 500,
      "minimum": 10,
      "maximum": 5000,
      "unit": "jobs"
    },
    "postedWithinDays": {
      "title": "Posted Within",
      "type": "integer",
      "description": "Only include jobs posted in the last N days.",
      "default": 30,
      "minimum": 1,
      "maximum": 365,
      "unit": "days"
    },
    "enableAIClassification": {
      "title": "Enable AI Scoring",
      "type": "boolean",
      "description": "Use AI to score job relevance (0-100). Adds $3 per 1,000 jobs but improves quality.",
      "default": false
    },
    "sources": {
      "title": "Data Sources",
      "type": "array",
      "description": "Select ATS platforms and job boards to query.",
      "editor": "select",
      "items": {
        "type": "string",
        "enum": [
          "greenhouse",
          "lever",
          "ashby",
          "workable",
          "smartrecruiters",
          "personio",
          "remoteok",
          "remotive",
          "arbeitnow",
          "himalayas",
          "hn_whoshiring",
          "jobicy"
        ],
        "enumTitles": [
          "Greenhouse",
          "Lever",
          "Ashby",
          "Workable",
          "SmartRecruiters",
          "Personio",
          "RemoteOK",
          "Remotive",
          "Arbeitnow",
          "Himalayas",
          "HN Who's Hiring",
          "Jobicy"
        ]
      },
      "default": [
        "greenhouse",
        "lever",
        "ashby",
        "remoteok",
        "remotive"
      ],
      "sectionCaption": "Advanced Settings",
      "sectionDescription": "Fine-tune sources, visa registries, and execution parameters."
    },
    "visaRegistryCountries": {
      "title": "Visa Registry Countries",
      "type": "array",
      "description": "Official sponsor registries to check against.",
      "editor": "select",
      "items": {
        "type": "string",
        "enum": [
          "UK",
          "US"
        ],
        "enumTitles": [
          "UK (Skilled Worker Register)",
          "US (DOL LCA Filings)"
        ]
      },
      "default": [
        "UK",
        "US"
      ]
    },
    "minVisaConfidence": {
      "title": "Minimum Visa Confidence",
      "type": "string",
      "description": "Minimum confidence level required.",
      "editor": "select",
      "default": "unknown",
      "enum": [
        "unknown",
        "historical_filings",
        "on_sponsor_list",
        "stated_in_jd"
      ],
      "enumTitles": [
        "Any (include unknown)",
        "Historical Filings+",
        "On Sponsor List+",
        "Stated in JD only"
      ]
    },
    "includeUnknownVisa": {
      "title": "Include Unknown Visa Status",
      "type": "boolean",
      "description": "Include jobs where sponsorship status is unknown (only when Visa Sponsorship Only is enabled).",
      "default": false
    },
    "employmentTypes": {
      "title": "Employment Type",
      "type": "array",
      "description": "Filter by contract type.",
      "editor": "select",
      "items": {
        "type": "string",
        "enum": [
          "full_time",
          "part_time",
          "contract",
          "internship"
        ],
        "enumTitles": [
          "Full-time",
          "Part-time",
          "Contract",
          "Internship"
        ]
      },
      "default": []
    },
    "sortBy": {
      "title": "Sort By",
      "type": "string",
      "description": "How to sort results.",
      "editor": "select",
      "default": "composite_score",
      "enum": [
        "composite_score",
        "relevance_score",
        "posted_at",
        "visa_confidence"
      ],
      "enumTitles": [
        "Composite Score (recommended)",
        "AI Relevance",
        "Date Posted",
        "Visa Confidence"
      ]
    },
    "includeDescription": {
      "title": "Include Job Description",
      "type": "boolean",
      "description": "Include full job description text in output.",
      "default": true
    },
    "concurrency": {
      "title": "Concurrency",
      "type": "integer",
      "description": "Number of sources to fetch in parallel (advanced).",
      "default": 5,
      "minimum": 1,
      "maximum": 20
    },
    "maxRuntimeSecs": {
      "title": "Max Runtime",
      "type": "integer",
      "description": "Maximum run time in seconds before timeout.",
      "default": 300,
      "minimum": 60,
      "maximum": 3600,
      "unit": "seconds"
    }
  }
}