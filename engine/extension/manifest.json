{
  "manifest_version": 3,
  "name": "Job Acquisition Engine & Copilot",
  "short_name": "JobEngine",
  "description": "Simplify-class ATS autofill, AI-powered resume tailoring, and cover letter generator for job applications.",
  "version": "1.2.0",
  "icons": {
    "16":  "icons/icon16.png",
    "48":  "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Job Acquisition Engine",
    "default_icon": {
      "16":  "icons/icon16.png",
      "48":  "icons/icon48.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.greenhouse.io/*",
        "*://boards-api.greenhouse.io/*",
        "*://*.lever.co/*",
        "*://*.ashbyhq.com/*",
        "*://*.myworkdayjobs.com/*",
        "*://*.myworkday.com/*",
        "*://*.myworkdaysite.com/*",
        "*://*.smartrecruiters.com/*",
        "*://*.icims.com/*",
        "*://*.taleo.net/*",
        "*://*.oraclecloud.com/*",
        "*://*.avature.net/*",
        "*://*.adp.com/*",
        "*://*.workable.com/*",
        "*://*.personio.de/*",
        "*://*.personio.com/*",
        "*://*.teamtailor.com/*",
        "*://*.recruitee.com/*",
        "*://*.bamboohr.com/*",
        "*://*.linkedin.com/*",
        "*://*.indeed.com/*",
        "*://*.allegro.eu/*",
        "*://*.nofluffjobs.com/*",
        "*://*.justjoin.it/*"
      ],
      "js": ["content.js"],
      "css": ["autofill/overlay.css"],
      "run_at": "document_idle",
      "all_frames": true,
      "match_origin_as_fallback": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "autofill/overlay.css",
        "autofill/*.js",
        "autofill/*.json",
        "autofill/adapters/*.js"
      ],
      "matches": ["<all_urls>"]
    }
  ],
  "permissions": [
    "activeTab",
    "storage",
    "scripting",
    "downloads",
    "sidePanel"
  ],
  "host_permissions": [
    "http://127.0.0.1:8000/*",
    "http://localhost:8000/*",
    "https://*.up.railway.app/*",
    "*://*.greenhouse.io/*",
    "*://boards-api.greenhouse.io/*",
    "*://*.lever.co/*",
    "*://*.ashbyhq.com/*",
    "*://*.myworkdayjobs.com/*",
    "*://*.myworkday.com/*",
    "*://*.myworkdaysite.com/*",
    "*://*.smartrecruiters.com/*",
    "*://*.workable.com/*",
    "*://*.linkedin.com/*",
    "*://*.indeed.com/*"
  ],
  "optional_host_permissions": [
    "*://*/*"
  ],
  "options_ui": {
    "page": "popup/options.html",
    "open_in_tab": false
  }
}
