{
  "manifest_version": 3,
  "name": "Job Acquisition Engine",
  "short_name": "JobEngine",
  "description": "AI-powered resume tailoring and cover letter generator. Optimize your application for any job in seconds.",
  "version": "1.0.0",
  "icons": {
    "16":  "icons/icon16.png",
    "48":  "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Job Acquisition Engine",
    "default_icon": {
      "16":  "icons/icon16.png",
      "48":  "icons/icon48.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.linkedin.com/*",
        "*://*.indeed.com/*",
        "*://*.greenhouse.io/*",
        "*://*.lever.co/*",
        "*://*.ashbyhq.com/*",
        "*://*.workable.com/*",
        "*://*.myworkdayjobs.com/*",
        "*://*.smartrecruiters.com/*",
        "*://*.jobvite.com/*",
        "*://*.icims.com/*",
        "*://*.breezy.hr/*",
        "*://justjoin.it/*",
        "*://*.wellfound.com/*",
        "*://*.ycombinator.com/*",
        "*://*/*/jobs/*",
        "*://*/*/careers/*",
        "*://*/*/job-offer/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "activeTab",
    "storage",
    "scripting",
    "downloads"
  ],
  "host_permissions": [
    "https://job-engine-production.up.railway.app/*",
    "http://localhost:8000/*"
  ],
  "options_ui": {
    "page": "popup/options.html",
    "open_in_tab": false
  }
}
