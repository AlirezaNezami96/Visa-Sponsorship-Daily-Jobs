# Required — Gemini AI
GEMINI_API_KEY=your-gemini-api-key-here

# Required — Session security (min 32 chars, generate with: openssl rand -hex 32)
SESSION_SECRET=change-me-to-a-random-32-char-string-at-minimum

# Google Docs & Drive Integration (Service Account)
GOOGLE_CREDENTIALS_PATH=credentials.json
GOOGLE_DRIVE_FOLDER_ID=your-google-drive-folder-id-here

# Optional — Model overrides (defaults shown)
GEMINI_PRO_MODEL=gemini-3.7-flash
GEMINI_FLASH_MODEL=gemini-3.7-flash

# Optional — Storage
PDF_OUTPUT_DIR=/tmp/engine_docs
SESSION_TTL_SECONDS=7200
PDF_TTL_SECONDS=7200

# Optional — Rate limiting (requests per hour per IP)
RATE_LIMIT_PER_HOUR=10

# Optional — CORS (comma-separated list of allowed origins)
# For production: set to your extension's chrome-extension://... ID
ALLOWED_ORIGINS=chrome-extension://*,http://localhost:*

# Optional — Logging
LOG_LEVEL=INFO
