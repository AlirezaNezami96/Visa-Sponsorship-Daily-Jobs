# Environment Variables / GitHub Secrets Template
# Copy this file to .env for local testing or use these exact keys in GitHub Secrets.

# AI Model APIs Configuration
GEMINI_API_KEY=

# Email Delivery (choose one provider)
EMAIL_PROVIDER=resend          # Options: resend | sendgrid | gmail
EMAIL_TO=your@email.com
EMAIL_FROM=noreply@yourdomain.com

# Resend (free 3,000/mo — https://resend.com)
RESEND_API_KEY=

# SendGrid (free 100/day)
SENDGRID_API_KEY=

# Gmail SMTP
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Supabase Dedup Store
# One shared table across all three tracks (visa, remote, ai_intern)
# Get URL + service-role key from: https://app.supabase.com → Settings → API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=service_role_key_here

# Resume ATS Matching
# Google Doc ID: the long hash in your doc's URL (https://docs.google.com/document/d/[THIS_PART]/edit)
# Ensure the doc is shared "Anyone with the link → Viewer" for link_shared access method
RESUME_DOC_ID=1a0qvUX6B2hqSdTT2EoKJF1e3L_m5ee4LxIZaMbU5FNA

# (Optional) For service_account access method instead of link_shared
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

# Telegram Bot Configuration (LinkedIn post publishing)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_AUTHORIZED_USER_ID=

# LinkedIn API Configuration
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_PERSON_URN=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# GitHub Configuration (Optional, only if branch protection requires PAT)
# GH_PAT=
