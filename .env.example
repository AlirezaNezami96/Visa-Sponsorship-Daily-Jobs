# Environment Variables / GitHub Secrets Template
# Copy this file to .env for local testing or use these exact keys in GitHub Secrets.

# AI Model APIs Configuration
GEMINI_API_KEY=

# Email Delivery (choose one provider)
EMAIL_PROVIDER=resend          # Options: resend | sendgrid | gmail
EMAIL_TO=your@email.com
EMAIL_FROM=noreply@yourdomain.com

# Resend (free 3,000/mo — https://resend.com)
RESEND_API_KEY=

# SendGrid (free 100/day)
SENDGRID_API_KEY=

# Gmail SMTP
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Supabase Dedup Store
# One shared table across all three tracks (visa, remote, ai_intern)
# Get URL + service-role key from: https://app.supabase.com → Settings → API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=service_role_key_here

# Resume ATS Matching
# Google Doc ID: the long hash in your doc's URL (https://docs.google.com/document/d/[THIS_PART]/edit)
# Ensure the doc is shared "Anyone with the link → Viewer" for link_shared access method
RESUME_DOC_ID=1a0qvUX6B2hqSdTT2EoKJF1e3L_m5ee4LxIZaMbU5FNA

# (Optional) For service_account access method instead of link_shared
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

# Telegram Bot Configuration (LinkedIn post publishing)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_AUTHORIZED_USER_ID=

# LinkedIn API Configuration
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_PERSON_URN=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Apollo People Search Configuration (Hiring contacts discovery)
APOLLO_API_KEY=

# GitHub Configuration (Optional, only if branch protection requires PAT)
# GH_PAT=

# ── VisaLane unified backend ────────────────────────────────────────────────
# Post-scrape sync into the VisaLane tables (companies/jobs/alerts/social).
# Set to 1 to enable the inline sync stage in the radar run (default off).
VISALANE_SYNC=0
VISALANE_ENRICHMENT=0

# Email fallback chain: Resend -> Brevo -> SendGrid -> Gmail SMTP
BREVO_API_KEY=

# Notification channels (auto-post targets; LinkedIn/X stay manual-review)
DISCORD_WEBHOOK_URL=
SLACK_WEBHOOK_URL=

# Edge Functions (Supabase dashboard -> Edge Functions -> Secrets)
# SUPABASE_ANON_KEY, SUPABASE_SERVICE_ROLE_KEY are injected by Supabase.
# GEMINI_API_KEY / GROQ_API_KEY / OPENROUTER_API_KEY feed the AI waterfall.
# PROCESS_JOBS_SECRET guards the internal process-new-jobs function.
# GOOGLE_SERVICE_ACCOUNT_JSON / GDRIVE_BACKUP_FOLDER_ID drive DB backups.
